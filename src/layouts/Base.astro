---
import { palettes, type Variant } from '../data/palettes';
import { temConteudoPendente } from '../data/site';
import SchemaDentist from '../components/SchemaDentist.astro';
import '../styles/global.css';

interface Props {
  variant: Variant;
  titulo: string;
  descricao: string;
}

const { variant, titulo, descricao } = Astro.props;
const p = palettes[variant];

/** Enquanto houver [[PENDENTE]] no conteúdo, o site não deve ser indexado. */
const pendente = temConteudoPendente();

const vars = Object.entries(p.tokens)
  .map(([nome, valor]) => `--c-${nome}: ${valor};`)
  .join('\n    ');

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.jpg', Astro.site).href;

/** Fontes baixadas para public/fonts/ — servidas pelo próprio site, sem CDN. */
const FONTES_AUTO_HOSPEDADAS = new Set(['Inter', 'Bricolage Grotesque']);

const fontesGoogle = [p.fontes.titulo, p.fontes.corpo]
  .filter((f) => !FONTES_AUTO_HOSPEDADAS.has(f))
  .map((f) => `family=${f.replace(/ /g, '+')}:wght@400;500;600;700`)
  .join('&');

const preloadTitulo = FONTES_AUTO_HOSPEDADAS.has(p.fontes.titulo)
  ? `/fonts/${p.fontes.titulo.toLowerCase().replace(/ /g, '-')}-700.woff2`
  : null;
---
<!doctype html>
<html lang="pt-BR" data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    {pendente && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-400.woff2" crossorigin />
    {preloadTitulo && (
      <link rel="preload" as="font" type="font/woff2" href={preloadTitulo} crossorigin />
    )}
    {fontesGoogle && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fontesGoogle}&display=swap`} />
      </>
    )}

    <style is:inline set:html={`:root {
    ${vars}
    --f-titulo: '${p.fontes.titulo}';
    --f-corpo: '${p.fontes.corpo}';
  }`} />

    <SchemaDentist />
  </head>
  <body>
    <a href="#conteudo" class="sr-only pular-conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
