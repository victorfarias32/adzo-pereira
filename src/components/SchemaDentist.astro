---
import { site } from '../data/site';
import { numeroFormatado } from '../lib/whatsapp';

/**
 * site.localizacao.endereco/.horarios ainda podem estar marcados como
 * [[PENDENTE]] (spec §8) — enquanto isso for verdade, omitimos os campos
 * do JSON-LD em vez de publicar o marcador como se fosse dado real.
 */
const enderecoPendente = site.localizacao.endereco.includes('[[PENDENTE]]');
const horariosPendente = site.localizacao.horarios.includes('[[PENDENTE]]');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: site.nome,
  description: `${site.titulo}. ${site.cro}.`,
  medicalSpecialty: 'Endodontic',
  telephone: numeroFormatado(),
  areaServed: 'Recife, PE, Brasil',
  address: {
    '@type': 'PostalAddress',
    ...(enderecoPendente ? {} : { streetAddress: site.localizacao.endereco }),
    addressLocality: 'Recife',
    addressRegion: 'PE',
    addressCountry: 'BR',
  },
  ...(horariosPendente ? {} : { openingHours: site.localizacao.horarios }),
  sameAs: [site.instagram],
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
