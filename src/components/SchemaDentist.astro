---
import { site } from '../data/site';
import { numeroFormatado } from '../lib/whatsapp';

/**
 * site.localizacao.endereco ainda pode estar marcado como [[PENDENTE]]
 * (spec §8) — enquanto isso for verdade, omitimos o campo do JSON-LD em
 * vez de publicar o marcador como se fosse dado real.
 *
 * Não há CEP (não informado pelo cliente) nem openingHours (o cliente
 * pediu para não publicar horários) — nenhum dos dois deve ser emitido.
 */
const enderecoPendente = site.localizacao.endereco.includes('[[PENDENTE]]');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: site.nome,
  description: `${site.titulo}. ${site.cro}.`,
  medicalSpecialty: 'Endodontic',
  telephone: numeroFormatado(),
  areaServed: 'Recife, PE, Brasil',
  address: {
    '@type': 'PostalAddress',
    ...(enderecoPendente ? {} : { streetAddress: site.localizacao.endereco }),
    addressLocality: 'Recife',
    addressRegion: 'PE',
    addressCountry: 'BR',
  },
  sameAs: [site.instagram],
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
